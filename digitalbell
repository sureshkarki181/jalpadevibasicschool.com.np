                titleEl.textContent = 'घण्टी सम्पादन गर्नुहोस्';
                document.getElementById('bellTimeInput').value = bell.time;
                document.getElementById('bellDurationInput').value = bell.duration;
                document.getElementById('bellLabelInput').value = bell.label;
                document.getElementById('bellEnabledInput').checked = bell.enabled;
                populateSoundSelect(bell.sound);
            } else {
                titleEl.textContent = 'नयाँ घण्टी थप्नुहोस्';
                document.getElementById('bellTimeInput').value = '10:00';
                document.getElementById('bellDurationInput').value = 5;
                document.getElementById('bellLabelInput').value = '';
