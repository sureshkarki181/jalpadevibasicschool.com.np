        // Add / Edit Bell Modal
        function openBellModal(bellId = null) {
            const modal = document.getElementById('bellModal');
            const titleEl = document.getElementById('bellModalTitle');
            document.getElementById('bellEditId').value = bellId || '';

            if (bellId) {
                const bell = (appState.schedules[appState.activeMode] || []).find(b => b.id === bellId);
