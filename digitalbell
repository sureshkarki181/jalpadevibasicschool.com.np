        function getEffectiveScheduleInfo(now) {
            const dayIdx = now.getDay(); // 0=Sunday, 1=Mon ... 5=Friday, 6=Saturday
            const s = appState.settings;

            if (s.holidayPause) {
                return { paused: true, reason: 'सार्वजनिक बिदा मोडमा बन्द छ', mode: appState.activeMode, bells: [] };
            }
            if ((dayIdx === 6 || dayIdx === 0) && s.autoOffWeekend) {
                return { paused: true, reason: 'साप्ताहिक बिदा (शनिबार र आइतबार बन्द)', mode: appState.activeMode, bells: [] };
            }

            // Monday to Friday (including Friday full day) uses the selected active mode directly
            const effectiveMode = appState.activeMode;
            const bells = (appState.schedules[effectiveMode] || [])
                .filter(b => b.enabled)
                .slice()
                .sort((a, b) => a.time.localeCompare(b.time));

            return { paused: false, reason: '', mode: effectiveMode, bells };
        }

        function formatDisplayTime(hhmm) {
            if (!hhmm || !hhmm.includes(':')) return hhmm;
            const [hStr, mStr] = hhmm.split(':');
            let h = parseInt(hStr, 10);
            if (appState.settings.use24Hour) {
                return `${String(h).padStart(2, '0')}:${mStr}`;
            }
            const ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return `${String(h).padStart(2, '0')}:${mStr} ${ampm}`;
        }

        function formatCountdown(totalSec) {
            const s = Math.max(0, Math.floor(totalSec));
            const hrs = Math.floor(s / 3600);
            const mins = Math.floor((s % 3600) / 60);
            const secs = s % 60;
            return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        let currentNextBellId = null;
let lastTickMs = null;

        /* ==========================================================================
           BIKRAM SAMBAT (BS) DATE — calendar data for BS 2070–2099
           ========================================================================== */
        const BS_START = 2070;
        const BS_ANCHOR = Date.UTC(2013, 3, 14); // 1 Baisakh 2070 = 14 April 2013
        const BS_MONTH_DAYS = [
            [31,31,31,32,31,31,29,30,30,29,30,30],
            [31,31,32,31,31,31,30,29,30,29,30,30],
            [31,32,31,32,31,30,30,29,30,29,30,30],
