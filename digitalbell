        async function acquireWakeLock() {
            const indicator = document.getElementById('wakeLockIndicator');
            const sentinel = await navigator.wakeLock.request('screen');
            wakeLockSentinel = sentinel;
            sentinel.addEventListener('release', () => {
                // The browser releases the lock when the tab is hidden; clear it so it can be re-acquired
                if (wakeLockSentinel === sentinel) wakeLockSentinel = null;
                indicator.classList.add('hidden');
                indicator.classList.remove('inline-flex');
            });
            indicator.classList.remove('hidden');
            indicator.classList.add('inline-flex');
        }

        async function handleWakeLockToggle(enabled) {
            const indicator = document.getElementById('wakeLockIndicator');
            if (enabled) {
                if ('wakeLock' in navigator) {
                    try {
                        await acquireWakeLock();
                        showToast('स्क्रिन अन राख्ने सुविधा सक्रिय भयो।', 'success');
                    } catch (err) {
                        document.getElementById('toggleWakeLock').checked = false;
                        showToast('स्क्रिन अन राख्न सकिएन (ब्याट्री सेभर वा ब्राउजर सीमितता)।', 'error');
                    }
                } else {
                    document.getElementById('toggleWakeLock').checked = false;
                    showToast('तपाईँको ब्राउजरले Wake Lock API समर्थन गर्दैन।', 'error');
                }
            } else {
                if (wakeLockSentinel) {
                    try { await wakeLockSentinel.release(); } catch (_) {}
                    wakeLockSentinel = null;
                }
                indicator.classList.add('hidden');
                indicator.classList.remove('inline-flex');
                showToast('स्क्रिन अन राख्ने सुविधा बन्द गरियो।', 'info');
            }
        }

        document.addEventListener('visibilitychange', async () => {
            if (document.visibilityState === 'visible' && document.getElementById('toggleWakeLock').checked && !wakeLockSentinel && 'wakeLock' in navigator) {
