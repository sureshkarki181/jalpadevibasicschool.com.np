        /* ==========================================================================
           INDEXEDDB CUSTOM AUDIO LIBRARY
           ========================================================================== */
        const AudioDB = {
            dbName: 'NepaliDigitalBellAudioDB',
            storeName: 'audioFiles',
            db: null,

            async open() {
                if (this.db) return this.db;
                return new Promise((resolve, reject) => {
                    try {
                        const req = indexedDB.open(this.dbName, 1);
                        req.onupgradeneeded = (e) => {
                            const db = e.target.result;
                            if (!db.objectStoreNames.contains(this.storeName)) {
                                db.createObjectStore(this.storeName, { keyPath: 'id' });
                            }
                        };
                        req.onsuccess = (e) => {
                            this.db = e.target.result;
                            resolve(this.db);
                        };
                        req.onerror = () => reject(req.error);
                    } catch (err) {
                        reject(err);
                    }
                });
            },

            async getAll() {
                const db = await this.open();
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(this.storeName, 'readonly');
                    const req = tx.objectStore(this.storeName).getAll();
                    req.onsuccess = () => resolve(req.result || []);
                    req.onerror = () => reject(req.error);
                });
            },

            async get(id) {
                const db = await this.open();
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(this.storeName, 'readonly');
                    const req = tx.objectStore(this.storeName).get(id);
                    req.onsuccess = () => resolve(req.result || null);
                    req.onerror = () => reject(req.error);
                });
            },

            async put(record) {
                const db = await this.open();
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(this.storeName, 'readwrite');
                    const req = tx.objectStore(this.storeName).put(record);
                    req.onsuccess = () => resolve(record);
                    req.onerror = () => reject(req.error);
                });
            },

            async delete(id) {
                const db = await this.open();
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(this.storeName, 'readwrite');
                    const req = tx.objectStore(this.storeName).delete(id);
                    req.onsuccess = () => resolve();
                    req.onerror = () => reject(req.error);
                });
            }
        };

        /* ==========================================================================
           OFFLINE WEB AUDIO ENGINE (SYNTHESIZED BELLS + CUSTOM AUDIO + SPEECH)
           ========================================================================== */
        class DigitalBellAudioEngine {
            constructor() {
                this.ctx = null;
                this.masterGain = null;
                this.isUnlocked = false;
                this.speaking = false;
                this.playToken = 0;
                this.activeNodes = [];
                this.activeTimers = [];
                this.activeHtmlAudio = null;
                this.activeObjectUrl = null;
                this.countdownTimer = null;
                this.volume = (appState.settings.volume ?? 85) / 100;
            }

            ensureContext() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (!AudioCtx) return null;
                    this.ctx = new AudioCtx();
                    this.masterGain = this.ctx.createGain();
                    this.masterGain.gain.value = this.volume;
                    this.masterGain.connect(this.ctx.destination);
                    this.ctx.onstatechange = () => {
                        this.isUnlocked = this.ctx.state === 'running';
                        updateAudioUnlockUI();
                    };
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume().catch(() => {});
                }
                this.isUnlocked = this.ctx.state === 'running';
                return this.ctx;
            }

            setVolume(percent) {
                this.volume = Math.max(0, Math.min(1, percent / 100));
                if (this.masterGain && this.ctx) {
                    this.masterGain.gain.setTargetAtTime(this.volume, this.ctx.currentTime, 0.02);
                }
                if (this.activeHtmlAudio) {
                    this.activeHtmlAudio.volume = this.volume;
                }
            }

            stopAll() {
                this.playToken++;
                this.speaking = false;
                this.activeTimers.forEach(t => clearTimeout(t));
                this.activeTimers = [];

                if (this.countdownTimer) {
                    clearInterval(this.countdownTimer);
                    this.countdownTimer = null;
                }

                this.activeNodes.forEach(node => {
                    try { if (typeof node.stop === 'function') node.stop(); } catch (_) {}
                    try { if (typeof node.disconnect === 'function') node.disconnect(); } catch (_) {}
                });
                this.activeNodes = [];

                if (this.activeHtmlAudio) {
                    try {
                        this.activeHtmlAudio.pause();
                        this.activeHtmlAudio.currentTime = 0;
                    } catch (_) {}
                    this.activeHtmlAudio = null;
                }
                if (this.activeObjectUrl) {
                    URL.revokeObjectURL(this.activeObjectUrl);
                    this.activeObjectUrl = null;
                }

                if ('speechSynthesis' in window) {
                    try { window.speechSynthesis.cancel(); } catch (_) {}
                }

                hideRingingBanner();
            }

            async play(soundKey, durationSec = 5, label = 'घण्टी', speakAfter = false) {
                this.stopAll();
                const token = this.playToken;
                const ctx = this.ensureContext();
                updateAudioUnlockUI();

                showRingingBanner(label, durationSec);

                // Built-in synthesized sounds are capped at 60s to keep the browser responsive
                const synthDur = Math.min(60, Math.max(1, Number(durationSec) || 5));
                const fallbackBell = () => {
                    if (!ctx) {
                        showToast('यो ब्राउजरमा Web Audio समर्थित छैन।', 'error');
                        hideRingingBanner();
                        return;
                    }
                    this.playElectricBell(ctx, synthDur, label, speakAfter);
                };

                // Custom uploaded audio from IndexedDB
                if (soundKey && soundKey.startsWith('custom:')) {
                    const audioId = soundKey.replace('custom:', '');
                    try {
                        const record = await AudioDB.get(audioId);
                        if (token !== this.playToken) return; // stopped or replaced while loading
                        if (!record || !record.blob) {
                            showToast('कस्टम अडियो फेला परेन, इलेक्ट्रिक घण्टी बजाइँदैछ।', 'error');
                            fallbackBell();
                            return;
                        }
                        this.playCustomBlob(record.blob, durationSec, label, speakAfter);
                    } catch (err) {
                        console.error('Custom audio error:', err);
                        if (token === this.playToken) fallbackBell();
                    }
                    return;
                }

                if (!ctx) {
                    showToast('यो ब्राउजरमा Web Audio समर्थित छैन।', 'error');
                    hideRingingBanner();
                    return;
                }

                switch (soundKey) {
                    case 'gong':
                        this.playBrassGong(ctx, synthDur, label, speakAfter);
                        break;
                    case 'chime':
                        this.playSoftChime(ctx, synthDur, label, speakAfter);
                        break;
                    case 'siren':
                        this.playEmergencySiren(ctx, synthDur, label, speakAfter);
                        break;
                    case 'electric':
                    default:
                        this.playElectricBell(ctx, synthDur, label, speakAfter);
                        break;
                }
            }

            scheduleFinish(durationSec, label, speakAfter) {
                if (this.countdownTimer) clearInterval(this.countdownTimer);
                let remaining = durationSec;
                const cdEl = document.getElementById('ringingCountdown');
                if (cdEl) cdEl.textContent = `${remaining} सेकेन्ड बाँकी`;

                this.countdownTimer = setInterval(() => {
                    remaining -= 1;
                    if (remaining > 0 && cdEl) {
                        cdEl.textContent = `${remaining} सेकेन्ड बाँकी`;
                    }
                }, 1000);

                const endTimer = setTimeout(() => {
                    if (speakAfter) {
                        if (this.countdownTimer) { clearInterval(this.countdownTimer); this.countdownTimer = null; }
                        this.speakLabel(label);
                    } else {
                        this.stopAll(); // releases audio nodes and hides the banner
                    }
                }, durationSec * 1000 + 250);
                this.activeTimers.push(endTimer);
            }

            /* 1. Electric School Bell (Rapid metallic clapper strikes) */
            playElectricBell(ctx, durationSec, label, speakAfter) {
                const startTime = ctx.currentTime + 0.03;
                const strikeInterval = 0.055; // ~18 strikes/sec
                const totalStrikes = Math.floor(durationSec / strikeInterval);
                const partials = [1180, 2375, 3680, 5140];

                for (let i = 0; i < totalStrikes; i++) {
                    const t = startTime + i * strikeInterval;
                    partials.forEach((freq, idx) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = idx % 2 === 0 ? 'sine' : 'triangle';
                        osc.frequency.setValueAtTime(freq + (Math.random() * 14 - 7), t);

                        const amp = [0.35, 0.25, 0.18, 0.12][idx];
                        gain.gain.setValueAtTime(0.0001, t);
                        gain.gain.linearRampToValueAtTime(amp, t + 0.004);
                        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.065);

                        osc.connect(gain);
                        gain.connect(this.masterGain);
                        osc.start(t);
                        osc.stop(t + 0.07);
                        this.activeNodes.push(osc, gain);
                    });
                }
                this.scheduleFinish(durationSec, label, speakAfter);
            }

            /* 2. Traditional Metallic Brass Gong */
            playBrassGong(ctx, durationSec, label, speakAfter) {
                const startTime = ctx.currentTime + 0.03;
                const strikeEvery = 1.75;
                const strikes = Math.max(1, Math.ceil(durationSec / strikeEvery));
                const partials = [
                    { f: 310, a: 0.45, d: 1.8 },
                    { f: 622, a: 0.30, d: 1.5 },
                    { f: 948, a: 0.22, d: 1.2 },
                    { f: 1475, a: 0.16, d: 0.9 },
                    { f: 2210, a: 0.10, d: 0.6 }
                ];

                for (let s = 0; s < strikes; s++) {
                    const t = startTime + s * strikeEvery;
                    if (t - startTime >= durationSec) break;
                    partials.forEach((p, idx) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = idx === 0 ? 'sine' : 'triangle';
                        osc.frequency.setValueAtTime(p.f, t);

                        gain.gain.setValueAtTime(0.0001, t);
                        gain.gain.linearRampToValueAtTime(p.a, t + 0.012);
                        gain.gain.exponentialRampToValueAtTime(0.0001, t + p.d);

                        osc.connect(gain);
                        gain.connect(this.masterGain);
                        osc.start(t);
                        osc.stop(t + p.d + 0.05);
                        this.activeNodes.push(osc, gain);
                    });
                }
                this.scheduleFinish(durationSec, label, speakAfter);
            }

            /* 3. Soft Melodic Chime (Westminster / School Intercom) */
            playSoftChime(ctx, durationSec, label, speakAfter) {
                const startTime = ctx.currentTime + 0.03;
                const notes = [523.25, 659.25, 783.99, 1046.50, 783.99, 659.25, 523.25];
                const step = 0.55;
                let elapsed = 0;
                let idx = 0;

                while (elapsed < durationSec) {
                    const t = startTime + elapsed;
                    const freq = notes[idx % notes.length];

                    const osc = ctx.createOscillator();
                    const osc2 = ctx.createOscillator();
                    const gain = ctx.createGain();

                    osc.type = 'sine';
                    osc2.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, t);
                    osc2.frequency.setValueAtTime(freq * 2, t);

                    gain.gain.setValueAtTime(0.0001, t);
                    gain.gain.linearRampToValueAtTime(0.35, t + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.0001, t + 1.1);

                    osc.connect(gain);
                    osc2.connect(gain);
                    gain.connect(this.masterGain);

                    osc.start(t);
                    osc2.start(t);
                    osc.stop(t + 1.15);
                    osc2.stop(t + 1.15);
                    this.activeNodes.push(osc, osc2, gain);

                    elapsed += step;
                    idx++;
                }
                this.scheduleFinish(durationSec, label, speakAfter);
            }

            /* 4. Emergency Siren */
            playEmergencySiren(ctx, durationSec, label, speakAfter) {
                const startTime = ctx.currentTime + 0.03;
                const endTime = startTime + durationSec;

                const osc = ctx.createOscillator();
                const filter = ctx.createBiquadFilter();
                const gain = ctx.createGain();

                osc.type = 'sawtooth';
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(1800, startTime);

                const cycle = 1.2;
                let t = startTime;
                osc.frequency.setValueAtTime(560, startTime);
                while (t < endTime) {
                    osc.frequency.linearRampToValueAtTime(1180, Math.min(t + cycle / 2, endTime));
                    osc.frequency.linearRampToValueAtTime(560, Math.min(t + cycle, endTime));
                    t += cycle;
                }

                gain.gain.setValueAtTime(0.001, startTime);
                gain.gain.linearRampToValueAtTime(0.32, startTime + 0.08);
                gain.gain.setValueAtTime(0.32, Math.max(startTime + 0.1, endTime - 0.1));
                gain.gain.linearRampToValueAtTime(0.0001, endTime);

                osc.connect(filter);
                filter.connect(gain);
                gain.connect(this.masterGain);

                osc.start(startTime);
                osc.stop(endTime + 0.05);
                this.activeNodes.push(osc, filter, gain);

                this.scheduleFinish(durationSec, label, speakAfter);
            }

            /* 5. Play Custom Uploaded Blob */
            playCustomBlob(blob, durationSec, label, speakAfter) {
                const url = URL.createObjectURL(blob);
                this.activeObjectUrl = url;
                const audio = new Audio(url);
                audio.volume = this.volume;
                this.activeHtmlAudio = audio;

                const cdEl = document.getElementById('ringingCountdown');
                if (cdEl) cdEl.textContent = durationSec > 0 ? `${durationSec} सेकेन्ड` : 'पूरा अडियो बज्दैछ...';

                audio.onended = () => {
                    if (speakAfter) {
                        this.speakLabel(label);
                    } else {
                        this.stopAll();
                    }
                };
                audio.onerror = () => {
                    showToast('कस्टम अडियो बजाउन सकिएन।', 'error');
                    this.stopAll();
                };

                audio.play().catch(err => {
                    console.error('Audio play blocked:', err);
                    showToast('अडियो बज्नको लागि "अडियो सक्रिय गर्नुहोस्" मा क्लिक गर्नुहोस्।', 'error');
                    this.stopAll();
                });

                if (durationSec > 0) {
                    this.scheduleFinish(durationSec, label, speakAfter);
                    const stopTimer = setTimeout(() => {
                        if (this.activeHtmlAudio === audio) {
                            audio.pause();
                        }
                    }, durationSec * 1000);
                    this.activeTimers.push(stopTimer);
                }
            }

            /* 6. Optional Web Speech API Voice Announcement */
            speakLabel(text) {
                if (this.speaking) return; // avoid announcing twice
                this.speaking = true;
                if (!('speechSynthesis' in window) || !text) {
                    hideRingingBanner();
                    return;
                }
                try {
                    window.speechSynthesis.cancel();
                    const utter = new SpeechSynthesisUtterance(text);
                    const voices = window.speechSynthesis.getVoices();
                    const neVoice = voices.find(v => v.lang.startsWith('ne')) || voices.find(v => v.lang.startsWith('hi'));
                    if (neVoice) utter.voice = neVoice;
                    utter.lang = neVoice ? neVoice.lang : 'ne-NP';
                    utter.rate = 0.92;
                    utter.volume = this.volume;

                    const cdEl = document.getElementById('ringingCountdown');
                    if (cdEl) cdEl.textContent = 'भ्वाइस सूचना...';

                    utter.onend = () => hideRingingBanner();
                    utter.onerror = () => hideRingingBanner();
                    window.speechSynthesis.speak(utter);
                } catch (e) {
                    hideRingingBanner();
                }
            }
        }

