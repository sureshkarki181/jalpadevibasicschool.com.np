    <style>
        body {
            font-family: 'Noto Sans Devanagari', 'Nirmala UI', 'Mangal', 'Kohinoor Devanagari', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .font-mono-clock {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-variant-numeric: tabular-nums;
        }
        @keyframes bell-shake {
            0%, 100% { transform: rotate(0deg); }
            15% { transform: rotate(18deg); }
            30% { transform: rotate(-16deg); }
            45% { transform: rotate(14deg); }
            60% { transform: rotate(-12deg); }
            75% { transform: rotate(8deg); }
        }
        .animate-bell-shake {
            animation: bell-shake 0.7s ease-in-out infinite;
            transform-origin: top center;
        }
        @keyframes pulse-ring {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55); }
            70% { box-shadow: 0 0 0 14px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .animate-pulse-ring {
            animation: pulse-ring 1.5s infinite;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
<style id="adminCss">
body.viewer [onclick^="openBellModal"], body.viewer [onclick^="confirmDeleteBell"], body.viewer [onclick^="testBell"],
body.viewer [onclick^="openSchoolModal"], body.viewer [onclick^="manualRing"], body.viewer [onclick^="confirmResetDefaults"],
body.viewer [onclick^="exportScheduleJSON"], body.viewer [onclick^="confirmDeleteCustomAudio"],
body.viewer label:has(#audioUploadInput) { display: none !important; }
body.viewer #modeTabs, body.viewer label:has(#toggleHoliday), body.viewer label:has(#toggleAutoWeekend),
body.viewer label:has(#toggleVoice), body.viewer label:has([onchange^="toggleBellEnabled"]) { pointer-events: none; opacity: .65; }
</style>
