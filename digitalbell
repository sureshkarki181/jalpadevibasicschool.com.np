            [31,31,32,31,31,31,30,29,30,29,30,30],
            [31,32,31,32,31,30,30,30,29,29,30,30],
            [31,32,31,32,31,30,30,30,29,30,29,31],
            [31,31,31,32,31,31,30,29,30,29,30,30],
            [31,31,32,31,31,31,30,29,30,29,30,30],
            [31,32,31,32,31,30,30,30,29,29,30,30],
            [31,32,31,32,31,30,30,30,29,30,29,31],
            [31,31,32,31,31,31,30,29,30,29,30,30],
            [31,31,32,31,31,31,30,29,30,29,30,30],
            [31,31,32,31,31,30,30,30,29,30,30,30],
            [31,32,31,32,30,31,30,30,29,30,30,30],
            [30,32,31,32,31,30,30,30,29,30,30,30],
            [31,31,32,31,31,31,30,30,29,30,30,30],
            [30,31,32,32,30,31,30,30,29,30,30,30],
            [30,32,31,32,31,30,30,30,29,30,30,30],
            [30,32,31,32,31,30,30,30,29,30,30,30],
            [31,31,32,31,31,31,30,30,29,30,30,30],
            [30,31,32,32,31,30,30,30,29,30,30,30],
            [30,32,31,32,31,30,30,30,29,30,30,30],
            [31,31,32,31,31,30,30,30,29,30,30,30],
            [31,31,32,31,31,31,30,29,30,30,30,30],
            [30,31,32,32,31,30,30,29,30,29,30,30],
            [31,32,31,32,31,30,30,30,29,30,30,30],
            [31,31,32,31,31,31,29,30,29,30,29,31],
            [31,32,31,32,31,30,30,30,29,29,30,31]
        ];
        const BS_MONTHS = ['बैशाख', 'जेठ', 'असार', 'श्रावण', 'भदौ', 'असोज', 'कार्तिक', 'मंसिर', 'पुष', 'माघ', 'फागुन', 'चैत'];
        const BS_WEEKDAYS = ['आइतबार', 'सोमबार', 'मंगलबार', 'बुधबार', 'बिहीबार', 'शुक्रबार', 'शनिबार'];
        function nepDigits(n) { return String(n).replace(/[0-9]/g, c => '०१२३४५६७८९'[c]); }
        function adToBs(date) {
            let d = Math.round((Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) - BS_ANCHOR) / 86400000);
            if (d < 0) return null;
            let yi = 0;
            while (yi < BS_MONTH_DAYS.length) {
                const len = BS_MONTH_DAYS[yi].reduce((a, b) => a + b, 0);
                if (d >= len) { d -= len; yi++; } else break;
            }
            if (yi >= BS_MONTH_DAYS.length) return null;
            let m = 0;
            while (d >= BS_MONTH_DAYS[yi][m]) { d -= BS_MONTH_DAYS[yi][m]; m++; }
            return { y: BS_START + yi, m, d: d + 1 };
        }
        function formatBsDate(date) {
            const b = adToBs(date);
            if (!b) return '';
            return `${nepDigits(b.d)} ${BS_MONTHS[b.m]} ${nepDigits(b.y)}, ${BS_WEEKDAYS[date.getDay()]}`;
        }

        function tick() {
            const now = new Date();
            const nowMs = now.getTime();
            const prevMs = lastTickMs ?? (nowMs - 1000);
            lastTickMs = nowMs;
            const h24 = now.getHours();
            const m = now.getMinutes();
            const s = now.getSeconds();
            const dayIdx = now.getDay();

            // 1. Update Live Clock
            const clockEl = document.getElementById('liveClockTime');
            const ampmEl = document.getElementById('liveClockAmPm');
            if (appState.settings.use24Hour) {
                clockEl.textContent = `${String(h24).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                ampmEl.textContent = '';
            } else {
                const h12 = h24 % 12 || 12;
                clockEl.textContent = `${String(h12).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                ampmEl.textContent = h24 >= 12 ? 'PM' : 'AM';
            }

            // Date & Nepali Day
            document.getElementById('nepaliDayBadge').textContent = NEPALI_DAYS[dayIdx];
            const dateStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
            const bsText = formatBsDate(now);
            document.getElementById('currentDateDisplay').textContent = bsText ? `${bsText} (${dateStr})` : dateStr;

            // 2. Effective Schedule & Status Badge
            const info = getEffectiveScheduleInfo(now);
            updateMasterStatusBadge(info);

            document.getElementById('effectiveModeBadge').textContent = MODE_LABELS[info.mode] || info.mode;

            // 3. Next Bell Calculation & Auto-Trigger
            const nextNameEl = document.getElementById('nextBellName');
            const nextTimeEl = document.getElementById('nextBellTimeText');
            const nextCdEl = document.getElementById('nextBellCountdown');

            if (info.paused) {
                nextNameEl.textContent = info.reason;
                nextTimeEl.textContent = 'स्वचालित घण्टी रोकिएको छ';
                nextCdEl.textContent = '--:--:--';
                if (currentNextBellId !== null) {
                    currentNextBellId = null;
                    renderScheduleTable();
                }
                return;
            }

            const nowSeconds = h24 * 3600 + m * 60 + s;
            const currentHHMM = `${String(h24).padStart(2, '0')}:${String(m).padStart(2, '0')}`;

            // Trigger every bell whose time passed since the previous tick (catches up if the
            // browser throttled timers in a background tab); once per bell per day.
            info.bells.forEach(bell => {
                const [bh, bm] = bell.time.split(':').map(Number);
                const bellMs = new Date(now.getFullYear(), now.getMonth(), now.getDate(), bh, bm, 0, 0).getTime();
                if (bellMs > prevMs && bellMs <= nowMs && nowMs - bellMs < 120000) {
                    const trigKey = `${dateStr}|${bell.time}|${bell.id}`;
                    if (!lastTriggeredKeys.has(trigKey)) {
                        lastTriggeredKeys.add(trigKey);
                        if (!audioEngine.isUnlocked) {
                            showToast('अडियो सक्रिय छैन — घण्टी नबज्न सक्छ। "अडियो सक्रिय गर्नुहोस्" थिच्नुहोस्।', 'error');
                        }
                        audioEngine.play(bell.sound, bell.duration, bell.label, appState.settings.voiceAnnouncement);
                        showToast(`स्वचालित घण्टी बज्यो: ${bell.label}`, 'info');
                    }
                }
            });

            // Find upcoming bell today
            let nextBell = null;
            let diffSeconds = 0;

            for (const bell of info.bells) {
                const [bh, bm] = bell.time.split(':').map(Number);
                const bellSec = bh * 3600 + bm * 60;
                if (bellSec > nowSeconds) {
                    nextBell = bell;
                    diffSeconds = bellSec - nowSeconds;
                    break;
                }
            }

            if (nextBell) {
                nextNameEl.textContent = nextBell.label;
                nextTimeEl.textContent = `${formatDisplayTime(nextBell.time)} • ${getSoundName(nextBell.sound)}`;
                nextCdEl.textContent = formatCountdown(diffSeconds);
                if (currentNextBellId !== nextBell.id) {
                    currentNextBellId = nextBell.id;
                    renderScheduleTable();
                }
            } else {
                nextNameEl.textContent = info.bells.length ? 'आजका सबै घण्टी सम्पन्न भए' : 'कुनै सक्रिय घण्टी छैन';
                nextTimeEl.textContent = 'भोलिको समयतालिकाको प्रतीक्षामा';
                nextCdEl.textContent = '00:00:00';
                if (currentNextBellId !== null) {
                    currentNextBellId = null;
                    renderScheduleTable();
                }
            }
        }

