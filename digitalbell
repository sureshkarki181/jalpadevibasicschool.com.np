        /* ==========================================================================
           ADMIN PIN, VIEW-ONLY MODE, PUBLISHED SCHEDULE (schedule.json)
           ========================================================================== */
        const LOCK_KEY = STORAGE_KEY + '_lock';
        let adminUntil = 0, pinFails = 0, pinLockedUntil = 0;

        function getLock() { try { return JSON.parse(localStorage.getItem(LOCK_KEY)); } catch (e) { return null; } }
        function setLock(o) { try { if (o) localStorage.setItem(LOCK_KEY, JSON.stringify(o)); else localStorage.removeItem(LOCK_KEY); } catch (e) {} }
        function hasPin() { const l = getLock(); return !!(l && l.hash && l.salt); }
        function isAdmin() { return Date.now() < adminUntil; }
        function canEdit() { return cloudMode ? cloudIsAdmin : (!hasPin() || isAdmin()); }
        function b64(buf) { let s = ''; new Uint8Array(buf).forEach(x => s += String.fromCharCode(x)); return btoa(s); }
        function unb64(s) { return Uint8Array.from(atob(s), c => c.charCodeAt(0)); }

        // PBKDF2-SHA1, 20000 iterations: same format as the Android app, so backups are interchangeable
        async function pinHash(pin, salt) {
            if (!(window.crypto && crypto.subtle)) throw new Error('nocrypto');
            const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(pin), 'PBKDF2', false, ['deriveBits']);
            return b64(await crypto.subtle.deriveBits({ name: 'PBKDF2', hash: 'SHA-1', salt, iterations: 20000 }, key, 256));
        }
        async function checkPin(pin) {
            const l = getLock(); if (!l) return true;
            try { return (await pinHash(pin, unb64(l.salt))) === l.hash; } catch (e) { return false; }
        }
        async function makeLock(pin) {
            const salt = crypto.getRandomValues(new Uint8Array(16));
            return { salt: b64(salt), hash: await pinHash(pin, salt) };
        }
        function sameLock(o) { const l = getLock(); return !!(l && o && o.hash === l.hash && o.salt === l.salt); }

        function showDialog(title, message, opts) {
            const ov = document.createElement('div');
            ov.style.cssText = 'position:fixed;inset:0;z-index:100;background:rgba(15,23,42,.6);display:flex;align-items:center;justify-content:center;padding:16px';
            const box = document.createElement('div');
            box.style.cssText = 'background:#fff;color:#0f172a;border-radius:16px;padding:20px;width:100%;max-width:360px;box-shadow:0 20px 50px rgba(0,0,0,.3)';
            const h = document.createElement('div'); h.textContent = title; h.style.cssText = 'font-weight:800;font-size:17px;margin-bottom:6px'; box.appendChild(h);
            if (message) { const p = document.createElement('div'); p.textContent = message; p.style.cssText = 'font-size:13px;color:#475569;margin-bottom:10px'; box.appendChild(p); }
            let inp = null;
            if (opts.input) {
                inp = document.createElement('input');
                inp.type = 'password'; inp.inputMode = 'numeric'; inp.autocomplete = 'off'; inp.placeholder = opts.input;
                inp.style.cssText = 'width:100%;box-sizing:border-box;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;font-size:18px;letter-spacing:4px;margin-bottom:6px';
                box.appendChild(inp); setTimeout(() => inp.focus(), 50);
            }
            const close = () => ov.remove();
            const btns = opts.buttons || [];
            btns.forEach(b => {
                const btn = document.createElement('button');
                btn.textContent = b.label;
                btn.style.cssText = 'display:block;width:100%;margin-top:8px;padding:10px;border-radius:10px;border:0;font-weight:700;font-size:14px;cursor:pointer;' +
                    (b.primary ? 'background:#4f46e5;color:#fff' : b.danger ? 'background:#fee2e2;color:#b91c1c' : 'background:#f1f5f9;color:#0f172a');
                btn.onclick = () => b.onClick ? b.onClick(inp ? inp.value : '', close) : close();
                box.appendChild(btn);
            });
            if (inp) inp.addEventListener('keydown', e => { if (e.key === 'Enter') { const pb = btns.find(x => x.primary); if (pb) pb.onClick(inp.value, close); } });
            ov.appendChild(box); document.body.appendChild(ov);
        }

        function openAdminMenu() {
            if (cloudMode) return cloudAdminMenu();
            if (!hasPin()) return setPinFlow();
            if (!isAdmin()) return loginFlow();
            showDialog('🔓 Admin मोड', '१० मिनेट निष्क्रिय भए आफैँ लक हुन्छ।', { buttons: [
                { label: '🔒 अहिले नै लक गर्नुहोस्', primary: true, onClick: (v, c) => { adminUntil = 0; c(); applyAccessMode(); } },
                { label: 'Admin PIN फेर्नुहोस्', onClick: (v, c) => { c(); setPinFlow(); } },
                { label: 'Admin PIN हटाउनुहोस्', danger: true, onClick: (v, c) => { c(); setLock(null); adminUntil = 0; applyAccessMode(); showToast('Admin PIN हटाइयो।', 'info'); } },
                { label: 'रद्द' }
            ] });
        }

        function loginFlow() {
            if (Date.now() < pinLockedUntil) { showToast('धेरै गलत प्रयास। १ मिनेट पर्खनुहोस्।', 'error'); return; }
            showDialog('🔑 Admin लगइन', 'Admin PIN लेख्नुहोस्', { input: 'PIN', buttons: [
                { label: 'लगइन', primary: true, onClick: async (v, c) => {
                    if (await checkPin(v)) { pinFails = 0; c(); adminUntil = Date.now() + 600000; applyAccessMode(); showToast('Admin मोड खुल्यो।', 'success'); }
                    else { if (++pinFails >= 5) { pinLockedUntil = Date.now() + 60000; pinFails = 0; } showToast('गलत PIN', 'error'); }
                } },
                { label: 'रद्द' }
            ] });
        }

        function setPinFlow() {
            showDialog('नयाँ Admin PIN', 'कम्तिमा ४ अङ्क (६ अङ्क राम्रो)', { input: 'नयाँ PIN', buttons: [
                { label: 'अर्को', primary: true, onClick: (p1, c) => {
                    if (!/^\d{4,}$/.test(p1)) { showToast('PIN कम्तिमा ४ अङ्कको हुनुपर्छ।', 'error'); return; }
                    c();
                    showDialog('PIN फेरि लेख्नुहोस्', '', { input: 'PIN फेरि', buttons: [
                        { label: 'सुरक्षित गर्नुहोस्', primary: true, onClick: async (p2, c2) => {
                            if (p1 !== p2) { showToast('PIN मेल खाएन।', 'error'); return; }
                            try { setLock(await makeLock(p1)); c2(); adminUntil = Date.now() + 600000; applyAccessMode(); showToast('Admin PIN सेट भयो। नबिर्सनुहोस्!', 'success'); }
                            catch (e) { showToast('यो ब्राउजरमा PIN सुरक्षित गर्न मिलेन (HTTPS वा नयाँ ब्राउजर चाहिन्छ)।', 'error'); }
                        } },
                        { label: 'रद्द' }
                    ] });
                } },
                { label: 'रद्द' }
            ] });
        }

        function applyAccessMode() {
            document.body.classList.toggle('viewer', !canEdit());
            const b = document.getElementById('adminBtn');
            if (b) b.textContent = cloudMode ? (cloudIsAdmin ? '🔓 Admin' : '🔒 Admin लगइन') : (!hasPin() ? '🔑 Admin PIN सेट' : (isAdmin() ? '🔓 Admin' : '🔒 हेर्ने मोड'));
            renderAll();
        }

        function requireEdit() {
            if (canEdit()) { if (isAdmin()) adminUntil = Date.now() + 600000; return true; }
            showToast('यो परिवर्तन गर्न Admin लगइन चाहिन्छ।', 'error');
            renderAll();
            return false;
        }

        // Guard every editing function (also protects against the buttons being un-hidden by hand)
        ['selectMode', 'openBellModal', 'saveBellForm', 'confirmDeleteBell', 'toggleBellEnabled', 'openSchoolModal', 'saveSchoolInfo',
         'handleAudioUpload', 'confirmDeleteCustomAudio', 'confirmResetDefaults', 'manualRing', 'testBell', 'exportScheduleJSON'].forEach(n => {
            const f = window[n];
            if (typeof f !== 'function') return;
            window[n] = function (...a) {
                if (!requireEdit()) { const e = a[0]; if (e && e.preventDefault) e.preventDefault(); return; }
                return f.apply(this, a);
            };
        });
        const _updateSetting = window.updateSetting;
        window.updateSetting = function (k, v) { if (!requireEdit()) return; return _updateSetting(k, v); };

        setInterval(() => {
            if (hasPin() && adminUntil && Date.now() >= adminUntil) { adminUntil = 0; applyAccessMode(); showToast('Admin सत्र सकियो, लक भयो।', 'info'); }
        }, 15000);
        document.addEventListener('pointerdown', () => { if (isAdmin()) adminUntil = Date.now() + 600000; }, true);

        // Apply a schedule published by the admin (keeps this device's own volume / clock-format choices)
        function adoptPublished(o) {
            const def = getDefaultState();
            appState.school = { ...def.school, ...(o.school || {}) };
            if (MODE_LABELS[o.activeMode]) appState.activeMode = o.activeMode;
            appState.schedules = { ...def.schedules, ...(o.schedules || {}) };
            const st = o.settings || {};
            ['holidayPause', 'autoOffWeekend', 'voiceAnnouncement'].forEach(k => { if (k in st) appState.settings[k] = st[k]; });
            saveState(); renderAll(); tick();
        }
        function scheduleSig(o) {
            const st = o.settings || {};
            return JSON.stringify([o.school, o.activeMode, o.schedules, st.holidayPause, st.autoOffWeekend]);
        }

        // Teachers open the website: if the admin uploaded "schedule.json" next to this page, load it automatically
        async function syncPublished() {
            try {
                if (cloudMode || isAdmin()) return;
                const r = await fetch('schedule.json?_=' + Date.now(), { cache: 'no-store' });
                if (!r.ok) return;
                const o = await r.json();
                if (!o || !o.schedules || !o.lock || !o.lock.hash || !o.lock.salt) return;
                if (hasPin() && !sameLock(o.lock)) return;
                if (hasPin() && scheduleSig(o) === scheduleSig(appState)) return;
                if (!hasPin()) setLock({ salt: o.lock.salt, hash: o.lock.hash });
                adoptPublished(o);
                applyAccessMode();
                showToast('Admin को नयाँ समयतालिका लोड भयो।', 'success');
            } catch (e) { /* offline or no schedule.json: ignore */ }
        }

        /* ==========================================================================
           ONLINE (FIREBASE): Admin signs in with Google; everyone else follows the published schedule
           ========================================================================== */
        const FIREBASE_CONFIG = {
            apiKey: "AIzaSyB84iw1FPA1oACtDzb56sKdXIyxWR9F0jY",
            authDomain: "jalpadevi-bell-c0aee.firebaseapp.com",
            projectId: "jalpadevi-bell-c0aee",
            storageBucket: "jalpadevi-bell-c0aee.firebasestorage.app",
            messagingSenderId: "495286942894",
            appId: "1:495286942894:web:8f80594187412160dd813f"
        };
        const ADMIN_EMAILS = ['jalpadevi338@gmail.com'];
        const FB_VER = '10.14.1';
        const cloudMode = false; // online sync disabled in the hosted preview
        let cloudIsAdmin = false, fb = null, suppressPublish = false, publishTimer = null, cloudIdleUntil = 0;

        async function cloudInit() {
            if (!cloudMode || fb) return fb;
            const base = `https://www.gstatic.com/firebasejs/${FB_VER}/`;
            const [appM, authM, fsM] = await Promise.all([
                import(base + 'firebase-app.js'), import(base + 'firebase-auth.js'), import(base + 'firebase-firestore.js')
            ]);
            const app = appM.initializeApp(FIREBASE_CONFIG);
            const f = { authM, fsM, auth: authM.getAuth(app), db: fsM.getFirestore(app) };
            f.ref = fsM.doc(f.db, 'schools', 'main');
            fb = f;
            authM.onAuthStateChanged(f.auth, onCloudAuth);
            fsM.onSnapshot(f.ref, onCloudSnapshot, err => console.warn('cloud', err));
            return f;
        }

        function onCloudAuth(user) {
            const ok = !!(user && user.email && ADMIN_EMAILS.includes(user.email.toLowerCase()));
            if (user && !ok) { showToast('यो Gmail Admin होइन। लगआउट गरियो।', 'error'); fb.authM.signOut(fb.auth); return; }
            const was = cloudIsAdmin;
            cloudIsAdmin = ok;
            if (ok) { cloudIdleUntil = Date.now() + 1800000; if (!was) adminSyncDown(); }
            applyAccessMode();
        }

        // After login: load what is online (or publish this browser's schedule if nothing is online yet)
        async function adminSyncDown() {
            try {
                const snap = await fb.fsM.getDoc(fb.ref);
                if (snap.exists()) { suppressPublish = true; adoptPublished(JSON.parse(snap.data().json)); applyAccessMode(); }
                else { await publishCloud(); }
            } catch (e) { showToast('ऑनलाइन डाटा लोड हुन सकेन: ' + (e.code || e.message), 'error'); }
            finally { suppressPublish = false; }
        }

        function onCloudSnapshot(snap) {
            if (cloudIsAdmin || !snap.exists()) return;
            try {
                const o = JSON.parse(snap.data().json);
                if (scheduleSig(o) !== scheduleSig(appState)) {
                    adoptPublished(o); applyAccessMode();
                    showToast('Admin को नयाँ समयतालिका लोड भयो।', 'success');
                }
            } catch (e) { console.warn('bad cloud data', e); }
        }

        async function publishCloud() {
            if (!cloudIsAdmin || !fb) return;
            const st = appState.settings;
            const o = { school: appState.school, activeMode: appState.activeMode, schedules: appState.schedules,
                settings: { holidayPause: !!st.holidayPause, autoOffWeekend: !!st.autoOffWeekend, voiceAnnouncement: !!st.voiceAnnouncement } };
            try {
                await fb.fsM.setDoc(fb.ref, { json: JSON.stringify(o), updatedAt: Date.now(), updatedBy: fb.auth.currentUser.email });
                showToast('✅ ऑनलाइन सुरक्षित भयो — सबै फोनमा अपडेट हुन्छ।', 'success');
            } catch (e) { showToast('ऑनलाइन सुरक्षित गर्न सकिएन: ' + (e.code || e.message), 'error'); }
        }

        // Every change an admin saves is published (after a short pause so quick edits go out together)
        const _saveState = window.saveState;
        window.saveState = function () {
            _saveState();
            if (cloudMode && cloudIsAdmin && !suppressPublish) {
                clearTimeout(publishTimer);
                publishTimer = setTimeout(publishCloud, 800);
            }
        };

        async function cloudAdminMenu() {
            if (!fb) { try { await cloudInit(); } catch (e) { showToast('इन्टरनेट वा Firebase मा समस्या छ। पछि प्रयास गर्नुहोस्।', 'error'); return; } }
            if (!cloudIsAdmin) {
                showDialog('🔑 Admin लगइन', 'विद्यालयको Admin Gmail बाट लगइन गर्नुहोस्।', { buttons: [
                    { label: 'Google ले लगइन', primary: true, onClick: async (v, c) => {
                        c();
                        try { await fb.authM.signInWithPopup(fb.auth, new fb.authM.GoogleAuthProvider()); }
                        catch (e) { showToast('लगइन हुन सकेन: ' + (e.code || e.message), 'error'); }
                    } },
                    { label: 'रद्द' }
                ] });
                return;
            }
            showDialog('🔓 Admin: ' + fb.auth.currentUser.email, 'परिवर्तन सुरक्षित हुँदा सबै फोनमा आफैँ अपडेट हुन्छ। ३० मिनेट निष्क्रिय भए आफैँ लगआउट हुन्छ।', { buttons: [
                { label: '☁ अहिले नै प्रकाशित गर्नुहोस्', primary: true, onClick: (v, c) => { c(); publishCloud(); } },
                { label: 'लगआउट', onClick: (v, c) => { c(); fb.authM.signOut(fb.auth); } },
                { label: 'रद्द' }
            ] });
        }

        setInterval(() => {
            if (cloudIsAdmin && fb && Date.now() > cloudIdleUntil) { fb.authM.signOut(fb.auth); showToast('सत्र सकियो, लगआउट भयो।', 'info'); }
        }, 30000);
        document.addEventListener('pointerdown', () => { if (cloudIsAdmin) cloudIdleUntil = Date.now() + 1800000; }, true);

        window.onload = async function () {
            syncHeaderHeight();
            renderAll();
            await loadCustomAudios();
            tick();
            setInterval(tick, 500);
            applyAccessMode();
            if (cloudMode) cloudInit().catch(e => console.warn('Firebase unavailable (offline?)', e));
            syncPublished();
            setInterval(syncPublished, 300000);
            document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') syncPublished(); });
        };
    </script>
