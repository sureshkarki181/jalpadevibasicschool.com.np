        // Custom Audio Upload & Delete
        async function loadCustomAudios() {
            try {
                const records = await AudioDB.getAll();
                customAudios = records.map(r => ({
                    id: r.id,
                    name: r.name,
                    size: r.blob ? r.blob.size : 0,
                    createdAt: r.createdAt
                })).sort((a, b) => b.createdAt - a.createdAt);
                renderCustomAudioList();
                renderScheduleTable();
            } catch (err) {
                console.error('IndexedDB load error:', err);
            }
        }

        async function handleAudioUpload(e) {
            const file = e.target.files[0];
            e.target.value = '';
            if (!file) return;

            if (file.size > 25 * 1024 * 1024) {
                showToast('कृपया २५ MB भन्दा सानो अडियो फाइल छान्नुहोस्।', 'error');
                return;
            }

            try {
                const id = 'aud_' + Date.now();
                const cleanName = file.name.replace(/\.[^/.]+$/, '');
                await AudioDB.put({
                    id,
                    name: cleanName,
                    type: file.type,
                    blob: file,
                    createdAt: Date.now()
                });
                await loadCustomAudios();
                showToast(`"${cleanName}" लाइब्रेरीमा सुरक्षित भयो!`, 'success');
            } catch (err) {
                console.error('Upload error:', err);
                showToast('अडियो सुरक्षित गर्न समस्या आयो।', 'error');
            }
        }

        function confirmDeleteCustomAudio(id) {
            openConfirmModal(
                'कस्टम अडियो हटाउनुहोस्',
                'यो अडियो लाइब्रेरीबाट स्थायी रूपमा हट्नेछ। के तपाईँ निश्चित हुनुहुन्छ?',
                async () => {
                    try {
                        await AudioDB.delete(id);
                        await loadCustomAudios();
                        showToast('कस्टम अडियो हटाइयो।', 'info');
                    } catch (err) {
                        showToast('अडियो हटाउन सकिएन।', 'error');
                    }
                }
            );
        }

        // Export / Import / Reset
        function exportScheduleJSON() {
            const dataStr = JSON.stringify(Object.assign({}, appState, getLock() ? { lock: getLock() } : {}), null, 2);
            const blob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `digital_bell_backup_${new Date().toISOString().slice(0, 10)}.json`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
            showToast('ब्याकअप JSON फाइल डाउनलोड भयो।', 'success');
        }

        function importScheduleJSON(e) {
            const file = e.target.files[0];
            e.target.value = '';
            if (!file) return;
            if (cloudMode && !canEdit()) { showToast('फाइल इम्पोर्ट गर्न Admin लगइन चाहिन्छ।', 'error'); return; }

            const reader = new FileReader();
            reader.onload = (ev) => {
                try {
                    const imported = JSON.parse(ev.target.result);
                    if (!imported || !imported.schedules) {
                        showToast('अमान्य ब्याकअप फाइल।', 'error');
                        return;
                    }
                    const lk = imported.lock;
                    if (hasPin() && !isAdmin()) {
                        if (!sameLock(lk)) { showToast('यो फाइल Admin को होइन। Admin PIN चाहिन्छ।', 'error'); return; }
                        adoptPublished(imported);
                        showToast('अपडेट सफल भयो!', 'success');
                        return;
                    }
                    if (!hasPin() && lk && lk.hash && lk.salt) setLock({ salt: lk.salt, hash: lk.hash });
                    const def = getDefaultState();
                    appState = {
                        school: { ...def.school, ...(imported.school || {}) },
                        activeMode: MODE_LABELS[imported.activeMode] ? imported.activeMode : def.activeMode,
                        settings: { ...def.settings, ...(imported.settings || {}) },
                        schedules: { ...def.schedules, ...(imported.schedules || {}) }
                    };
                    saveState();
                    renderAll();
                    tick();
                    showToast('समयतालिका सफलतापूर्वक रिस्टोर भयो!', 'success');
                    applyAccessMode();
                } catch (err) {
                    showToast('फाइल पढ्न सकिएन। सही JSON फाइल छान्नुहोस्।', 'error');
                }
            };
            reader.readAsText(file);
        }

