        function closeBellModal() {
            document.getElementById('bellModal').classList.add('hidden');
        }

        function saveBellForm(e) {
            e.preventDefault();
            const editId = document.getElementById('bellEditId').value;
            const time = document.getElementById('bellTimeInput').value;
            const duration = Math.max(0, parseInt(document.getElementById('bellDurationInput').value, 10) || 0);
            const label = document.getElementById('bellLabelInput').value.trim();
            const sound = document.getElementById('bellSoundSelect').value;
            const enabled = document.getElementById('bellEnabledInput').checked;

            if (!time || !label) return;

            const list = appState.schedules[appState.activeMode] || [];
            if (editId) {
                const idx = list.findIndex(b => b.id === editId);
                if (idx !== -1) {
                    list[idx] = { ...list[idx], time, duration, label, sound, enabled };
                    showToast('घण्टी सफलतापूर्वक अपडेट भयो।', 'success');
                }
            } else {
                list.push({
                    id: 'b_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                    time, duration, label, sound, enabled
                });
                showToast('नयाँ घण्टी थपियो।', 'success');
            }

            appState.schedules[appState.activeMode] = list;
            saveState();
            closeBellModal();
            renderScheduleTable();
            tick();
        }

